NODE_ENV=development
PORT=4000
DATABASE_URL=
# Keep the serverless runtime pool small; use Neon's pooled runtime URL.
DATABASE_POOL_MAX=3
FRONTEND_URL=http://localhost:3000
# Production OAuth callback origin. With the Pages proxy, use the frontend origin.
API_URL=http://localhost:4000
# Same random value in Cloudflare Pages and the API. Required in production.
API_PROXY_SECRET=
# Explicit development/test only; production startup refuses true.
AUTH_ALLOW_UNVERIFIED_EMAIL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Production Detective requires a stable signing key (at least 32 characters).
# Leave empty locally for an ephemeral key; production stays unavailable without it.
QUIZ_CHALLENGE_SECRET=
# Optional paths to the unchanged reader corpus assets when packaged separately.
QUIZ_CORPUS_INDEX=
QUIZ_CORPUS_DIRECTORY=
