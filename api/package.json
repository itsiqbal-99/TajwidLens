    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "google-auth-library": "^10.0.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.0",
